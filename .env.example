# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Convex dev deploy key (starts with dev:). npx convex reads it from .env.local.
CONVEX_DEPLOY_KEY=

# Written by npx convex dev: the deployment name and its URLs.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# For npm run deploy, these two live in .env (also git-ignored), not .env.local:
# a Cloudflare token that can deploy Workers and manage the nathanhealea.com zone,
# CLOUDFLARE_API_TOKEN=
# and the Convex production deploy key (starts with prod:). The dev key above must not be used for deploys.
# CONVEX_PROD_DEPLOY_KEY=

# Set in the Convex dashboard or with npx convex env set (never here, never as VITE_ variables):
# CLOUDFLARE_TURN_KEY_ID, CLOUDFLARE_TURN_KEY_API_TOKEN
