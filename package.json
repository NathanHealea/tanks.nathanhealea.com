{
  "name": "tanks",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc -p convex",
    "test": "vitest run --update none",
    "test:watch": "vitest",
    "deploy": "node --env-file=.env scripts/deploy.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "convex": "1.46.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "0.0.60",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  }
}
